{
  "name": "kompast",
  "private": true,
  "version": "0.2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @kompast/db generate",
    "db:migrate": "pnpm --filter @kompast/db migrate",
    "release": "node scripts/release.mjs patch",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "@types/node": "^22.10.0"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.2",
      "y-protocols": "1.0.7"
    }
  }
}
