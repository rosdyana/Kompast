{
  "name": "kompast",
  "private": true,
  "version": "0.4.1",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:docker": "node scripts/dev-services.mjs && set -a && . ./.env.local.dev && set +a && turbo run dev",
    "dev:services": "node scripts/dev-services.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:seed": "node scripts/demo.mjs seed",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @kompast/db generate",
    "db:migrate": "pnpm --filter @kompast/db migrate",
    "release": "node scripts/release.mjs patch",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "@types/node": "^26.6.6"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.2",
      "y-protocols": "1.0.7",
      "undici": ">=7.30.1 <8",
      "proxy-addr": ">=2.0.8",
      "body-parser": ">=2.4.0",
      "source-map-js": ">=1.2.2"
    }
  }
}
