{
  "name": "@kompast/collab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kompast/env": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "@types/node": "^22.10.0"
  }
}
