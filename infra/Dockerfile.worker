# syntax=docker/dockerfile:1
FROM node:25-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @kompast/worker build
# Production-only, self-contained deploy (same approach as Dockerfile.web).
# tsup bundles every dependency into dist/index.cjs, so the runtime needs
# little beyond dist/ and package.json; `deploy --prod` drops the root
# node_modules' dev tooling from the image.
RUN pnpm --filter @kompast/worker deploy --prod --legacy /app/deploy/worker

FROM base AS runtime
ENV NODE_ENV=production
RUN addgroup -S kompast && adduser -S kompast -G kompast
COPY --from=build /app/deploy/worker ./apps/worker
USER kompast
CMD ["node", "apps/worker/dist/index.cjs"]
