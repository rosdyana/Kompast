# syntax=docker/dockerfile:1
# Exact patched Node (CVE-2026-111497 "Node2Shell", Brotli RCE: fixed in 22.23.4 / 24.22.1 / 26.12.1;
# odd majors like 25 get no fix) pinned by digest so a stale cache can't ship an older 22.x.
# Dependabot bumps the tag+digest for patch/minor releases (see .github/dependabot.yml).
FROM node:22.23.5-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS base
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @kompast/worker build
# Production-only, self-contained deploy (same approach as Dockerfile.web).
# tsup bundles every dependency into dist/index.cjs, so the runtime needs
# little beyond dist/ and package.json; `deploy --prod` drops the root
# node_modules' dev tooling from the image.
RUN pnpm --filter @kompast/worker deploy --prod --legacy /app/deploy/worker

FROM base AS runtime
ENV NODE_ENV=production
# Pick up Alpine security fixes published after the pinned Node image was built
# (e.g. zlib CVE-2026-4738, fixed in 1.4-r0 while node:22.23.5-alpine shipped 1.3.2-r1).
RUN apk upgrade --no-cache
RUN addgroup -S kompast && adduser -S kompast -G kompast
# The runtime only ever runs `node`. The npm CLI bundled in the base image
# (and corepack's pnpm/yarn shims) are build tools: removing them keeps their
# dependency tree — which Trivy flags (e.g. brace-expansion, sigstore, pacote
# CVEs in npm's own node_modules) — out of the shipped image.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
      /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
      /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=build /app/deploy/worker ./apps/worker
USER kompast
CMD ["node", "apps/worker/dist/index.cjs"]
