# syntax=docker/dockerfile:1
# Exact patched Node (CVE-2026-111497 "Node2Shell", Brotli RCE: fixed in 22.23.4 / 24.22.1 / 26.12.1;
# odd majors like 25 get no fix) pinned by digest so a stale cache can't ship an older 22.x.
# Dependabot bumps the tag+digest for patch/minor releases (see .github/dependabot.yml).
FROM node:22.23.4-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202 AS base
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @kompast/collab build
# Production-only, self-contained deploy (same approach as Dockerfile.web).
# tsup bundles every dependency into dist/index.js, so the runtime needs
# little beyond dist/ and package.json; `deploy --prod` drops the root
# node_modules' dev tooling (tsup, tsx, vitest, typescript) from the image.
RUN pnpm --filter @kompast/collab deploy --prod --legacy /app/deploy/collab

FROM base AS runtime
ENV NODE_ENV=production
RUN addgroup -S kompast && adduser -S kompast -G kompast
COPY --from=build /app/deploy/collab ./apps/collab
USER kompast
EXPOSE 1234
CMD ["node", "apps/collab/dist/index.js"]
