# Copy to .env and fill in every value — packages/env refuses to boot on a
# missing/invalid one rather than silently misconfiguring in production.
#
# Deliberately minimal for a SaaS-style deploy: Microsoft Entra ID, the AI
# provider, and the mail vendor are NOT here. They're configured through
# the app itself — /setup on first boot (Entra ID, gates the very first
# login) and the admin /settings page after that (AI + mail) — and stored,
# encrypted, in the system_settings table. Everything below is strictly
# infra-level: what's needed to even reach the point of asking you to open
# /setup in a browser.

NODE_ENV=production
APP_URL=https://kompast.example.com
PORT=3000

# --- Ports exposed on the Debian host (Caddy reverse-proxies to these) ---
WEB_PORT=3000
COLLAB_PORT=1234
COLLAB_INTERNAL_PORT=1234
# The browser's own WebSocket URL for the docs editor (apps/collab) — goes
# through Caddy's /api/collab* route (see Caddyfile.example), not directly
# to COLLAB_PORT. Required: packages/env refuses to boot without it.
COLLAB_WS_URL=wss://kompast.example.com/api/collab

# --- Postgres ---
# Two roles, deliberately: Postgres always exempts superusers and table
# owners from row-level security, so the app must NEVER connect as the
# same role that owns the schema/runs migrations, or every RLS policy in
# packages/db/rls.sql silently does nothing. POSTGRES_USER/PASSWORD below
# provision the admin/owner role (used only by the one-shot `migrate`
# service); DATABASE_URL's role (kompast_app) is created automatically by
# that migrate step (packages/db/src/bootstrap-roles.ts) with just
# SELECT/INSERT/UPDATE/DELETE — pick its own separate password here, it is
# not derived from POSTGRES_PASSWORD.
POSTGRES_DB=kompast
POSTGRES_USER=kompast_admin
POSTGRES_PASSWORD=change-me
DATABASE_ADMIN_URL=postgres://kompast_admin:change-me@postgres:5432/kompast
DATABASE_URL=postgres://kompast_app:change-me-too@postgres:5432/kompast

# --- Redis ---
# The redis container requires a password (docker-compose.yml). Generate with:
# openssl rand -hex 24 (hex, so it needs no URL-escaping). REDIS_URL must carry
# the same password. install.sh and demo.sh write both values for you.
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379

# --- Better Auth ---
# Generate with: openssl rand -base64 32
# Also derives the at-rest encryption key for secrets saved via /setup and
# /settings (packages/core/src/crypto.ts) — losing this means losing access
# to those stored secrets, not just sessions. Back it up like a real secret.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=https://kompast.example.com

# --- Attachment storage ---
# Still infra-level (unlike Entra/AI/mail): the service-account JSON has to
# be mounted into the container regardless, so there's no real benefit to
# making bucket/project UI-configurable the same way. See README "GCP
# storage setup" for how to create the bucket + service account.
# STORAGE_DRIVER=local (the default) needs nothing below — it writes to a
# disk volume and is meant for dev/CI only, not a real multi-instance deploy.
STORAGE_DRIVER=gcs
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs.json
GCS_BUCKET=
GCS_PROJECT_ID=

# --- Dev-only Microsoft-Entra bypass (local debugging, NEVER set in prod) ---
# Lets you sign in as a fixed "dev-admin" account with a password instead of
# a real Entra tenant. Gated by BOTH this flag AND NODE_ENV !== "production"
# (see apps/web/src/lib/auth.ts's getDevAdminConfig) — with NODE_ENV=production
# above, ENABLE_DEV_LOGIN has no effect regardless of this value. Leave both
# unset/false for any real deployment. packages/env also refuses ENABLE_DEV_LOGIN=true unless NODE_ENV is set explicitly to
# development or test (NODE_ENV's default is not used for that check).
# ENABLE_DEV_LOGIN=false
# DEV_ADMIN_PASSWORD=

# --- Stakeholder demo mode (a demo-only deployment — see docs/DEMO.md) ---
# Turns on password sign-in for the seeded demo personas only (no public
# sign-up) and skips the /setup Entra gate. Works with NODE_ENV=production.
# The access code is every demo persona's password: share it with the
# audience alongside the URL. NEVER enable on a deployment with real data.
# DEMO_MODE=false
# DEMO_ACCESS_CODE=

# --- First-run /setup (optional) ---
# When set, the /setup form asks for this value, so whoever reaches the URL
# first on a fresh deploy can't pick the Entra tenant. install.sh generates
# one. At least 16 characters.
# SETUP_TOKEN=

# --- Outbound requests to user-chosen URLs (optional) ---
# Automation webhooks and JIRA import/migration refuse targets that resolve to
# private, loopback or link-local addresses (SSRF guard). To allow an on-prem
# JIRA on your internal network, list its hostname(s), comma-separated.
# The cloud metadata range (169.254.0.0/16) is never allowed.
# OUTBOUND_ALLOW_PRIVATE_HOSTS=jira.corp.example

# --- GHCR image pulls (docker-compose.yml) ---
GHCR_OWNER=your-github-org
IMAGE_TAG=latest
GCS_CREDENTIALS_HOST_PATH=./secrets/gcs-service-account.json
