# Copy to .env and fill in every value — packages/env refuses to boot on a
# missing/invalid one rather than silently misconfiguring in production.

NODE_ENV=production
APP_URL=https://kompast.example.com
PORT=3000

# --- Ports exposed on the Debian host (Caddy reverse-proxies to these) ---
WEB_PORT=3000
COLLAB_PORT=1234
COLLAB_INTERNAL_PORT=1234

# --- Postgres ---
# Two roles, deliberately: Postgres always exempts superusers and table
# owners from row-level security, so the app must NEVER connect as the
# same role that owns the schema/runs migrations, or every RLS policy in
# packages/db/rls.sql silently does nothing. POSTGRES_USER/PASSWORD below
# provision the admin/owner role (used only by the one-shot `migrate`
# service); DATABASE_URL's role (kompast_app) is created automatically by
# that migrate step (packages/db/src/bootstrap-roles.ts) with just
# SELECT/INSERT/UPDATE/DELETE — pick its own separate password here, it is
# not derived from POSTGRES_PASSWORD.
POSTGRES_DB=kompast
POSTGRES_USER=kompast_admin
POSTGRES_PASSWORD=change-me
DATABASE_ADMIN_URL=postgres://kompast_admin:change-me@postgres:5432/kompast
DATABASE_URL=postgres://kompast_app:change-me-too@postgres:5432/kompast

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=https://kompast.example.com

# --- Microsoft Entra ID (Azure AD) app registration ---
# Redirect URI to register on the app: https://kompast.example.com/api/auth/callback/microsoft-entra-id
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Google Cloud Storage ---
# See README "GCP storage setup" for how to create the bucket + service account.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs.json
GCS_BUCKET=
GCS_PROJECT_ID=

# --- Email (choose one driver) ---
MAIL_DRIVER=smtp
MAIL_FROM=noreply@example.com
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_URL=smtp://user:pass@smtp.example.com:587

# --- AI ---
AI_PROVIDER=anthropic
AI_FEATURES_ENABLED=false
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# --- GHCR image pulls (docker-compose.yml) ---
GHCR_OWNER=your-github-org
IMAGE_TAG=latest
GCS_CREDENTIALS_HOST_PATH=./secrets/gcs-service-account.json
