# Copy to .env and fill in every value — packages/env refuses to boot on a
# missing/invalid one rather than silently misconfiguring in production.
#
# Deliberately minimal for a SaaS-style deploy: Microsoft Entra ID, the AI
# provider, and the mail vendor are NOT here. They're configured through
# the app itself — /setup on first boot (Entra ID, gates the very first
# login) and the admin /settings page after that (AI + mail) — and stored,
# encrypted, in the system_settings table. Everything below is strictly
# infra-level: what's needed to even reach the point of asking you to open
# /setup in a browser.

NODE_ENV=production
APP_URL=https://kompast.example.com
PORT=3000

# --- Ports exposed on the Debian host (Caddy reverse-proxies to these) ---
WEB_PORT=3000
COLLAB_PORT=1234
COLLAB_INTERNAL_PORT=1234

# --- Postgres ---
# Two roles, deliberately: Postgres always exempts superusers and table
# owners from row-level security, so the app must NEVER connect as the
# same role that owns the schema/runs migrations, or every RLS policy in
# packages/db/rls.sql silently does nothing. POSTGRES_USER/PASSWORD below
# provision the admin/owner role (used only by the one-shot `migrate`
# service); DATABASE_URL's role (kompast_app) is created automatically by
# that migrate step (packages/db/src/bootstrap-roles.ts) with just
# SELECT/INSERT/UPDATE/DELETE — pick its own separate password here, it is
# not derived from POSTGRES_PASSWORD.
POSTGRES_DB=kompast
POSTGRES_USER=kompast_admin
POSTGRES_PASSWORD=change-me
DATABASE_ADMIN_URL=postgres://kompast_admin:change-me@postgres:5432/kompast
DATABASE_URL=postgres://kompast_app:change-me-too@postgres:5432/kompast

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Better Auth ---
# Generate with: openssl rand -base64 32
# Also derives the at-rest encryption key for secrets saved via /setup and
# /settings (packages/core/src/crypto.ts) — losing this means losing access
# to those stored secrets, not just sessions. Back it up like a real secret.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=https://kompast.example.com

# --- Attachment storage ---
# Still infra-level (unlike Entra/AI/mail): the service-account JSON has to
# be mounted into the container regardless, so there's no real benefit to
# making bucket/project UI-configurable the same way. See README "GCP
# storage setup" for how to create the bucket + service account.
# STORAGE_DRIVER=local (the default) needs nothing below — it writes to a
# disk volume and is meant for dev/CI only, not a real multi-instance deploy.
STORAGE_DRIVER=gcs
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs.json
GCS_BUCKET=
GCS_PROJECT_ID=

# --- GHCR image pulls (docker-compose.yml) ---
GHCR_OWNER=your-github-org
IMAGE_TAG=latest
GCS_CREDENTIALS_HOST_PATH=./secrets/gcs-service-account.json
