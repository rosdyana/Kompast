# syntax=docker/dockerfile:1
# One-shot stakeholder-demo seeder (see docs/DEMO.md):
#   docker compose -f docker-compose.yml -f docker-compose.demo.yml --profile seed run --rm seed-demo
# Runs apps/web/scripts/seed-demo.ts through tsx against the live database.
# It needs the full workspace (packages/core, BlockNote's server-side
# markdown → Yjs conversion via jsdom, tsx), so unlike the service images
# this is a single, unslimmed stage — fine for something run once per
# demo reset. Not published by release.yml; build it on the demo host.
# Node 26 LTS ("Lithium", EOL 2029-04-30), exact patched release (CVE-2026-111497 "Node2Shell", Brotli RCE: fixed in 22.23.4 / 24.22.1 / 26.12.1;
# odd majors like 25 get no fix) pinned by digest so a stale cache can't ship an older 22.x.
# Dependabot bumps the tag+digest for patch/minor releases (see .github/dependabot.yml).
FROM node:26.13.1-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5
# Node 25+ no longer bundles corepack: install it (exact version) so pnpm still
# comes from package.json's packageManager pin. Runtime stages delete it again.
RUN npm install -g corepack@0.36.0 && corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production
# Pick up Alpine security fixes published after the pinned Node image was built
# (e.g. zlib CVE-2026-4738, fixed in 1.4-r0 while node:22.23.5-alpine shipped 1.3.2-r1).
RUN apk upgrade --no-cache
RUN addgroup -S kompast && adduser -S kompast -G kompast
# Same script `pnpm --filter @kompast/web seed:demo` runs (cwd apps/web,
# tsx scripts/seed-demo.ts), but without pnpm at runtime: corepack would
# need a writable cache under the non-root user's home.
WORKDIR /app/apps/web
USER kompast
CMD ["node", "node_modules/tsx/dist/cli.mjs", "scripts/seed-demo.ts"]
