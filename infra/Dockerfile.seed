# syntax=docker/dockerfile:1
# One-shot stakeholder-demo seeder (see docs/DEMO.md):
#   docker compose -f docker-compose.yml -f docker-compose.demo.yml --profile seed run --rm seed-demo
# Runs apps/web/scripts/seed-demo.ts through tsx against the live database.
# It needs the full workspace (packages/core, BlockNote's server-side
# markdown → Yjs conversion via jsdom, tsx), so unlike the service images
# this is a single, unslimmed stage — fine for something run once per
# demo reset. Not published by release.yml; build it on the demo host.
FROM node:25-alpine
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production
RUN addgroup -S kompast && adduser -S kompast -G kompast
# Same script `pnpm --filter @kompast/web seed:demo` runs (cwd apps/web,
# tsx scripts/seed-demo.ts), but without pnpm at runtime: corepack would
# need a writable cache under the non-root user's home.
WORKDIR /app/apps/web
USER kompast
CMD ["node", "node_modules/tsx/dist/cli.mjs", "scripts/seed-demo.ts"]
