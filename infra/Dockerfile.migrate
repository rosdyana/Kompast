# syntax=docker/dockerfile:1
# One-shot migration runner: `docker compose run --rm migrate` (or as a
# `depends_on: service_completed_successfully` service — see
# docker-compose.yml). Ships packages/db's source + drizzle/ folder directly
# via tsx rather than a bundled build, since it only ever runs once per
# deploy and correctness (running the exact migration files) matters more
# than image size here.
# Exact patched Node (CVE-2026-111497 "Node2Shell", Brotli RCE: fixed in 22.23.4 / 24.22.1 / 26.12.1;
# odd majors like 25 get no fix) pinned by digest so a stale cache can't ship an older 22.x.
# Dependabot bumps the tag+digest for patch/minor releases (see .github/dependabot.yml).
FROM node:22.23.4-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202 AS base
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile

FROM base AS runtime
ENV NODE_ENV=production
RUN addgroup -S kompast && adduser -S kompast -G kompast
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=build /app/packages/db ./packages/db
COPY --from=build /app/packages/env ./packages/env
WORKDIR /app/packages/db
USER kompast
# Invoke tsx's entry point directly rather than `pnpm exec`: pnpm would need
# a writable home for corepack at runtime, which the non-root user does not
# have. The base image's corepack cache belongs to root.
CMD ["node", "node_modules/tsx/dist/cli.mjs", "src/migrate.ts"]
