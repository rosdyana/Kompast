# syntax=docker/dockerfile:1
# Exact patched Node (CVE-2026-111497 "Node2Shell", Brotli RCE: fixed in 22.23.4 / 24.22.1 / 26.12.1;
# odd majors like 25 get no fix) pinned by digest so a stale cache can't ship an older 22.x.
# Dependabot bumps the tag+digest for patch/minor releases (see .github/dependabot.yml).
FROM node:22.23.4-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202 AS base
RUN corepack enable
WORKDIR /app

# One COPY + install rather than per-package manifest copying: this monorepo
# gains new packages every phase (see plan §Phases), and a manifest allowlist
# silently goes stale the first time someone forgets to update it here.
FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @kompast/web... run --if-present build
# jsdom (a dependency of @blocknote/server-util, used for server-side
# markdown/HTML conversion in the pages REST + MCP routes) cannot be
# bundled into Nitro's otherwise-self-contained SSR output: one of its
# internal CJS modules loads its own bundled default stylesheet via
# `readFileSync(path.resolve(__dirname, ...))`, which breaks once
# relocated into a bundled chunk (see apps/web/vite.config.ts's
# `rollupConfig.external` for the full story — confirmed by a real
# `docker build`+`docker run`, not just `pnpm build`). It's declared as
# a direct dependency in apps/web/package.json so pnpm's strict
# isolation doesn't hide it as a phantom transitive dependency, and
# `pnpm deploy` here produces a real (non-symlinked-into-the-monorepo),
# production-only node_modules that resolves it correctly at runtime.
RUN pnpm --filter @kompast/web deploy --prod --legacy /app/deploy/web
# esbuild only reaches the prod tree through better-auth's dependency list
# (drizzle-kit, vitest); the Nitro server output never loads it. Its native
# binary is a Go program that Trivy flags for an old Go stdlib, so drop it
# here — in the build stage, so it never enters any runtime image layer.
RUN rm -rf /app/deploy/web/node_modules/.pnpm/esbuild@* /app/deploy/web/node_modules/.pnpm/@esbuild+*

FROM base AS runtime
ENV NODE_ENV=production
RUN addgroup -S kompast && adduser -S kompast -G kompast
# The runtime only ever runs `node`. The npm CLI bundled in the base image
# (and corepack's pnpm/yarn shims) are build tools: removing them keeps their
# dependency tree — which Trivy flags (e.g. brace-expansion, sigstore, pacote
# CVEs in npm's own node_modules) — out of the shipped image.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
      /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
      /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=build /app/deploy/web/node_modules ./node_modules
COPY --from=build /app/deploy/web/.output ./apps/web/.output
USER kompast
EXPOSE 3000
CMD ["node", "apps/web/.output/server/index.mjs"]
